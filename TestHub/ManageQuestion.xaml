<Window x:Class="TestHub.ManageQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestHub"
        mc:Ignorable="d"
        Title="ManageQuestion" Height="400" Width="600" ResizeMode="NoResize"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Question Text -->
            <RowDefinition Height="Auto" />
            <!-- Answers Manage -->
            <RowDefinition Height="Auto" />
            <!-- Exit Options -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Question Text -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
            <TextBlock Text="Question:" FontWeight="Bold" Margin="5" />
            <TextBox Name="QuestionTextBox" Text="{Binding QuestionPub.QuestionText}" />
        </StackPanel>
        
        <!-- Answers List -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
            <TextBlock Text="Answers:" FontWeight="Bold" Margin="5" />
            <ListBox Name="AnswersListBox" 
                     ItemsSource="{Binding QuestionPub.Answers}"  
                     SelectedItem="{Binding SelectedAnswer}" 
                     DisplayMemberPath="AnswerText"
                     Height="200">
            </ListBox>
        </StackPanel>

        <!-- Buttons Section -->
        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Bottom">
                <TextBox Name="AnswerTextBox" Margin="5"/>
                <Button Name="AddAnswerButton" Content="Add" Margin="5" Click="AddAnswerButton_Click" />
                <Button Name="UpdateAnswerButton" Content="Update" IsEnabled="{Binding AnswerIsSelected}" Margin="5" Click="UpdateAnswerButton_Click" />
                <Button Name="DeleteAnswerButton" Content="Delete" IsEnabled="{Binding AnswerIsSelected}" Margin="5" Click="DeleteAnswerButton_Click" />
            </StackPanel>
        </Grid>
        
        <!-- Close Options -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Name="OKButton" Grid.Column="0" HorizontalAlignment="Right" Content="OK" Width="60" Height="30" Margin="10,5" Click="OKButton_Click" />
            <Button Name="CancelButton" Grid.Column="1" Content="Cancel" Width="60" Height="30" Margin="10,5" Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Window>

