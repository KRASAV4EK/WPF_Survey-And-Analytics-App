<Window x:Class="TestHub.ManageProjects"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestHub"
        mc:Ignorable="d"
        Title="ManageProjects" Height="450" Width="900" ResizeMode="NoResize"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <StackPanel Grid.Column="0">
            <!-- Project List -->
            <ListBox Name="ProjListBox"
                     DisplayMemberPath="ProjTitle"
                     ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject}"
                     Margin="10"
                     Height="330">
            </ListBox>

            <!-- Manage Projects -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Name="CreateProjButton" Grid.Column="0" Content="Create" Height="40" Margin="10" Click="CreateProjButton_Click" />
                <Button Name="RemoveProjButton" Grid.Column="1" Content="Remove" IsEnabled="{Binding ProjectIsSelected}" Height="40" Margin="10" Click="RemoveProjButton_Click" />
            </Grid>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="350" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Questions and Answers -->
            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Questions List -->
                <ListBox Grid.Column="0"
                         DataContext="{Binding SelectedProject}"
                         ItemsSource="{Binding ProjQuestions}"
                         SelectedItem="{Binding SelectedQuestion}"
                         Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding QuestionText}" FontWeight="Bold" />
                                <ItemsControl ItemsSource="{Binding Answers}" Margin="10,0,0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AnswerText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Question Editor -->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Project title:" Margin="5"/>
                        <TextBox Name="ProjectTextBox" Text="{Binding SelectedProject.ProjTitle, Mode=OneWay}" Margin="5" IsEnabled="{Binding ProjectIsSelected}"/>
                        <Button Name="UpdProjectTitleButton" Content="Update" Margin="5" Click="UpdProjectTitleButton_Click" IsEnabled="{Binding ProjectIsSelected}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Question:" Margin="5"/>
                        <Button Content="Add" Margin="5" Click="AddQuestionButton_Click" IsEnabled="{Binding ProjectIsSelected}"/>
                        <Button Content="Edit" Margin="5" Click="EditQuestionButton_Click" IsEnabled="{Binding ProjectIsSelected}"/>
                        <Button Content="Remove" Margin="5" Click="RemoveQuestionButton_Click" IsEnabled="{Binding ProjectIsSelected}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Close Options -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                
                <Button Name="OKButton" Grid.Column="0" HorizontalAlignment="Right" Content="OK" Width="60" Height="30" Margin="10,5" Click="OKButton_Click" />
                <Button Name="CancelButton" Grid.Column="1" Content="Cancel" Width="60" Height="30" Margin="10,5" Click="CancelButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
